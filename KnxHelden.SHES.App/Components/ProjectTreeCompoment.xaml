<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KnxHelden.SHES.App.Components.ProjectTreeCompoment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KnxHelden.SHES.App.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:observables="using:KnxHelden.SHES.Models.Observables"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d"
    Loaded="{x:Bind ViewModel.OnLoaded}"
    SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
    </UserControl.Resources>

    <StackPanel>
        <CommandBar HorizontalAlignment="Left" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right">
            <AppBarButton x:Uid="StructureView_ProjectTree_AddButton" Icon="Add"
                  Command="{x:Bind ViewModel.AddProjectItemDialogCommand}"
                  CommandParameter="{Binding ElementName=AddProjectItemDialog}" />
            <AppBarButton x:Uid="StructureView_ProjectTree_DeleteButton"
                  Command="{x:Bind ViewModel.DeleteProjectItemCommand}"
                  Icon="Delete">
            </AppBarButton>
        </CommandBar>

        <ScrollViewer x:Name="ProjectTreeScrollViewer" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled">
            <StackPanel>
                <TreeView ItemsSource="{x:Bind ViewModel.ProjectItems, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedProjectItem, Mode=TwoWay}">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="observables:ObservableProjectItem">
                            <TreeViewItem ItemsSource="{x:Bind Children, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="{StaticResource MaterialDesignIcons}" Glyph="{Binding Icon}" Margin="0 0 5 0" />
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                
                <ProgressRing IsActive="{x:Bind ViewModel.IsTreeLoading, Mode=OneWay}" VerticalAlignment="Top" Background="LightGray" />
            </StackPanel>
        </ScrollViewer>

        <!-- DIALOG: New Project Item -->
        <ContentDialog x:Name="AddProjectItemDialog"
               x:Uid="StructureView_ProjectTree_AddDialog"
               DefaultButton="Primary"
               PrimaryButtonCommand="{x:Bind ViewModel.AddProjectItemCommand}"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.NewProjectItemDialogHasErrors, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
            <StackPanel>
                <ComboBox x:Uid="StructureView_ProjectTree_AddDialog_Type"
                  HeaderTemplate="{StaticResource RequiredHeaderTemplate}"
                  ItemsSource="{x:Bind ViewModel.RestrictedProjectItemInfos}"
                  SelectedItem="{x:Bind ViewModel.NewProjectItemType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="DisplayName"
                  Width="300"
                  Margin="0 0 0 10" />

                <TextBox x:Uid="StructureView_ProjectTree_AddDialog_Name"
                 HeaderTemplate="{StaticResource RequiredHeaderTemplate}"
                 Text="{x:Bind ViewModel.NewProjectItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Width="300" />
            </StackPanel>
        </ContentDialog>
    </StackPanel>
</UserControl>
