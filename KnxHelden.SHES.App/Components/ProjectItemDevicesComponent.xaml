<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KnxHelden.SHES.App.Components.ProjectItemDevicesComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KnxHelden.SHES.App.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:observables="using:KnxHelden.SHES.Models.Observables"
    mc:Ignorable="d">

    <Grid>
        <StackPanel>
            <ListView ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}">
                <ListView.Header>
                    <Grid Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Padding="16,5,12,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Uid="StructureView_ProjectItemDevices_List_Bus" />
                        <TextBlock x:Uid="StructureView_ProjectItemDevices_List_Location" Grid.Column="1" />
                        <TextBlock x:Uid="StructureView_ProjectItemDevices_List_Name" Grid.Column="2" />
                        <TextBlock x:Uid="StructureView_ProjectItemDevices_List_Type" Grid.Column="3" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="observables:ObservableDevice">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <FontIcon FontFamily="{StaticResource SmarthomeIcons}" Glyph="{Binding TypeIcon}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ProjectItem.Parent.Name}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ProjectItem.Name}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Type}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
