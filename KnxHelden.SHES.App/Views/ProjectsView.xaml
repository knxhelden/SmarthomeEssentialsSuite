<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KnxHelden.SHES.App.Views.ProjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KnxHelden.SHES.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:observables="using:KnxHelden.SHES.Models.Observables"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:validation="using:WinUIValidation"
    mc:Ignorable="d"
    Loaded="{x:Bind ViewModel.OnLoaded}">

    <Page.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="350" Width="2*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition MinWidth="250" Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- PROJECT LIST -->
        <StackPanel Padding="16">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,16">
                <SplitButton Command="{x:Bind ViewModel.OpenAddProjectDialogCommand}"
                             CommandParameter="{Binding ElementName=AddProjectDialog}"
                             Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" Margin="0 0 5 0" FontSize="13" />
                        <TextBlock x:Uid="ProjectView_NewButton" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel>
                                <MenuFlyoutItem x:Uid="ProjectView_NewButton_EtsImport"
                                                Command="{x:Bind ViewModel.ImportKnxProjectDialogCommand}"
                                                CommandParameter="{x:Bind ImportKnxProjectDialog}" />
                                <MenuFlyoutItem x:Uid="ProjectView_NewButton_OpenhabImport" />
                            </StackPanel>
                        </Flyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button x:Uid="ProjectView_OpenButton"
                        Command="{x:Bind ViewModel.OpenProjectCommand}"
                        Margin="0,0,8,0" />
                <Button IsEnabled="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" Margin="0 0 5 0" FontSize="13" />
                        <TextBlock x:Uid="ProjectView_DeleteButton" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel>
                                <TextBlock x:Uid="ProjectView_DeleteButton_ConfirmMessage" Style="{ThemeResource BaseTextBlockStyle}" Margin="0,0,0,12" />
                                <Button x:Uid="ProjectView_DeleteButton_ConfirmButton"
                                        Command="{x:Bind ViewModel.DeleteProjectCommand}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <ListView x:Name="ProjectList"
                      ItemsSource="{x:Bind ViewModel.ProjectList}"
                      SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="observables:ObservableProject">
                        <Grid Padding="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <FontIcon Grid.RowSpan="2" FontFamily="{StaticResource MaterialDesignIcons}" Glyph="&#xF07D2;" Foreground="DimGray" FontSize="30" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Name, Mode=OneWay}"
                                       Style="{ThemeResource BaseTextBlockStyle}"
                                       FontWeight="Bold"
                                       Margin="12,6,0,0" />
                            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                                <TextBlock Text="Projektnr.:"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           Margin="12,0,0,6" />
                                <TextBlock Text="{x:Bind Number, Mode=OneWay}"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           Margin="6,0,0,6" />
                            </StackPanel>
                            <Border Grid.Column="2" Grid.RowSpan="2" Background="Gray" CornerRadius="8" Padding="4,4,4,2" Margin="12,12,0,12">
                                <TextBlock Text="{x:Bind State, Mode=OneWay}" Foreground="White" FontSize="12" />
                            </Border>
                        </Grid>
                        
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <controls:GridSplitter Grid.Column="1"
                       Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

        <!-- PROJECT DETAILS -->
        <ScrollViewer Grid.Column="2"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      CornerRadius="0,10,10,0"
                      Padding="16">
            <validation:Form Model="{x:Bind ViewModel}">
            <StackPanel>

                    <TextBlock x:Uid="ProjectView_Project_Details"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,24" />
                    <TextBox x:Uid="ProjectView_Project_Name"
                             IsEnabled="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay}"
                             Text="{x:Bind ViewModel.SelectedProject.Name, Mode=TwoWay}"
                             MaxLength="50" />
                    <validation:ValidationFor PropertyName="SelectedProject.Name" Margin="0,5,0,0" />
                    <TextBox x:Uid="ProjectView_Project_Number"
                             IsEnabled="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay}"
                             Text="{x:Bind ViewModel.SelectedProject.Number, Mode=TwoWay}"
                             MaxLength="12"
                             Margin="0,16,0,0" />
                    <validation:ValidationFor PropertyName="SelectedProject.Number" Margin="0,5,0,0" />

                    <TextBlock x:Uid="ProjectView_Project_BuildingOwner"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,24,0,24" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="ProjectView_Project_FirstName"
                                 IsEnabled="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SelectedProject.ClientFirstName, Mode=TwoWay}"
                                 MaxLength="50"
                                 Margin="0,0,24,0" />
                        <validation:ValidationFor PropertyName="SelectedProject.ClientFirstName" Margin="0,5,0,0" />
                        <TextBox x:Uid="ProjectView_Project_LastName"
                                 Grid.Column="1"
                                 IsEnabled="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SelectedProject.ClientSurname, Mode=TwoWay}"
                                 MaxLength="50" />
                        <validation:ValidationFor PropertyName="SelectedProject.ClientSurname" Margin="0,5,0,0" />
                    </Grid>

                    <TextBox x:Uid="ProjectView_Project_Phone"
                             IsEnabled="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay}"
                             Text="{x:Bind ViewModel.SelectedProject.ClientPhone, Mode=TwoWay}"
                             MaxLength="15" />
                    <validation:ValidationFor PropertyName="SelectedProject.ClientPhone" Margin="0,5,0,0" />
                    <TextBox x:Uid="ProjectView_Project_Email"
                             IsEnabled="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay}"
                             Text="{x:Bind ViewModel.SelectedProject.ClientEmail, Mode=TwoWay}"
                             Margin="0,16,0,0" />
                    <validation:ValidationFor PropertyName="SelectedProject.ClientEmail" Margin="0,5,0,0" />

                    <TextBlock x:Uid="ProjectView_Project_ConstructionSite"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,24,0,24" />
                    <TextBox x:Uid="ProjectView_Project_Street"
                             IsEnabled="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay}"
                             Text="{x:Bind ViewModel.SelectedProject.ConstructionStreet, Mode=TwoWay}"
                             MaxLength="50" />
                    <validation:ValidationFor PropertyName="SelectedProject.ConstructionStreet" Margin="0,5,0,0" />
                    <Grid Margin="0,16,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="ProjectView_Project_Zip"
                                 IsEnabled="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SelectedProject.ConstructionPostalCode, Mode=TwoWay}"
                                 MaxLength="8"
                                 Margin="0,0,24,0" />
                        <validation:ValidationFor PropertyName="SelectedProject.ConstructionPostalCode" Margin="0,5,0,0" />
                        <TextBox x:Uid="ProjectView_Project_City"
                                 Grid.Column="1"
                                 IsEnabled="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SelectedProject.ConstructionCity, Mode=TwoWay}"
                                 MaxLength="50" />
                        <validation:ValidationFor PropertyName="SelectedProject.ConstructionCity" Margin="0,5,0,0" />
                    </Grid>
            </StackPanel>
            </validation:Form>
        </ScrollViewer>

        <!-- ADD PROJECT DIALOG-->
        <ContentDialog x:Uid="ProjectView_AddProjectDialog"
                       x:Name="AddProjectDialog"
                       PrimaryButtonCommand="{x:Bind ViewModel.AddProjectCommand}"
                       IsPrimaryButtonEnabled="{x:Bind ViewModel.NewProject.HasErrors, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                       DefaultButton="Primary">
            <StackPanel>
                <TextBox x:Uid="ProjectView_AddProjectDialog_Name"
                         Text="{x:Bind ViewModel.NewProject.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" />

                <TextBox x:Uid="ProjectView_AddProjectDialog_Number"
                         Text="{x:Bind ViewModel.NewProject.Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ContentDialog>
        
        <!-- KNX PROJECT IMPORT DIALOG -->
        <ContentDialog x:Uid="ProjectView_KnxImportDialog"
               x:Name="ImportKnxProjectDialog"
               PrimaryButtonCommand="{x:Bind ViewModel.ImportKnxProjectCommand}"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.ImportProjectDialogHasErrors, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
               DefaultButton="Primary">
            <StackPanel Margin="0 0 20 0">

                <!-- PASSWORD PROTECTION-->
                <StackPanel Visibility="{x:Bind ViewModel.IsKnxProjectProtected, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock TextWrapping="Wrap" x:Uid="ProjectView_KnxImportDialog_PasswordProtection" />
                    <PasswordBox x:Uid="ProjectView_KnxImportDialog_Password"
                         Password="{x:Bind ViewModel.KnxProjectPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HeaderTemplate="{StaticResource RequiredHeaderTemplate}"
                         Margin="0 10 0 0" />
                </StackPanel>

                <!-- IMPORT DATA -->
                <StackPanel Margin="0 20 0 0">
                    <TextBlock x:Uid="ProjectView_KnxImportDialog_ImportFilter" />
                    <CheckBox x:Uid="ProjectView_KnxImportDialog_MasterData"
                      IsChecked="True"
                      IsEnabled="False" Margin="0 10 0 0" />
                    <CheckBox x:Uid="ProjectView_KnxImportDialog_Structure"
                      IsChecked="{x:Bind ViewModel.ImportKnxStructure, Mode=TwoWay}" />
                    <CheckBox x:Uid="ProjectView_KnxImportDialog_Devices"
                      IsChecked="{x:Bind ViewModel.ImportKnxDevices, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
