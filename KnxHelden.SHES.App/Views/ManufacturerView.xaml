<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KnxHelden.SHES.App.Views.ManufacturerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KnxHelden.SHES.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:observables="using:KnxHelden.SHES.Models.Observables"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Loaded="{x:Bind ViewModel.Page_Loaded}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="350" Width="2*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition MinWidth="250" Width="1*" />
        </Grid.ColumnDefinitions>

        <ListView ItemsSource="{x:Bind ViewModel.Manufacturers, Mode=TwoWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedManufacturer, Mode=TwoWay}"
                  Margin="16,36,16,0">
            <ListView.Header>
                <Grid Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Padding="16,5,12,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Uid="ManufacturerView_List_Name" Grid.Column="2" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="observables:ObservableManufacturer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:GridSplitter Grid.Column="1"
               Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

        <ScrollViewer Grid.Column="2"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      CornerRadius="0,10,10,0"
              Padding="16">
            <StackPanel>
                <TextBlock x:Uid="ManufacturerView_Manufacturer_Details"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   Margin="0,0,0,24" />
                <TextBox x:Uid="ManufacturerView_Manufacturer_Name"
                 IsEnabled="{x:Bind ViewModel.IsManufacturerSelected, Mode=OneWay}"
                 Text="{x:Bind ViewModel.SelectedManufacturer.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 LostFocus="{x:Bind ViewModel.InputField_LostFocus}"
                 Margin="0,0,0,16" />

                <TextBlock x:Uid="ManufacturerView_Manufacturer_CreationDate"
                           Margin="0,0,0,12" />
                <TextBlock Text="{x:Bind ViewModel.SelectedManufacturer.CreationTime, Mode=OneWay}"
                           Margin="0,0,0,16" />

                <TextBlock x:Uid="ManufacturerView_Manufacturer_ModificationDate"
                           Margin="0,0,0,12" />
                <TextBlock Text="{x:Bind ViewModel.SelectedManufacturer.LastModificationTime, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
